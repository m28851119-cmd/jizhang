{
  "name": "wo-yao-jizhang",
  "productName": "我要记账",
  "version": "0.1.0",
  "description": "个人/家庭本地记账应用（Windows + macOS）",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "用户",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.jizhang.app",
    "productName": "我要记账",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "我要记账",
      "uninstallDisplayName": "我要记账"
    },
    "mac": {
      "target": "zip",
      "icon": "build/icon.png",
      "category": "public.app-category.finance"
    }
  },
  "devDependencies": {
    "electron": "^40.10.2",
    "electron-builder": "^26.18.0"
  }
}
